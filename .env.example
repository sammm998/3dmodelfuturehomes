# ---------------------------------------------------------------------------
# PropertyVerse configuration. Copy to .env (docker compose reads it too).
# Everything works without any keys: vision falls back to an offline heuristic,
# maps fall back to a stylised ground, photoreal layers are skipped.
# ---------------------------------------------------------------------------

# --- core (defaults match docker-compose.yml; change for production) ---
DATABASE_URL=postgres://propertyverse:propertyverse@localhost:5432/propertyverse
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333          # any S3-compatible store (AWS S3, R2, MinIO, SeaweedFS)
S3_REGION=us-east-1
S3_BUCKET=propertyverse
S3_ACCESS_KEY=propertyverse
S3_SECRET_KEY=propertyverse-secret
PUBLIC_API_URL=http://localhost:4000       # browser-facing API URL (also used for /files links)
PUBLIC_WEB_URL=http://localhost:3000       # browser-facing web URL (share links, QR codes)
NEXT_PUBLIC_API_URL=http://localhost:4000  # web app (local dev); compose passes PUBLIC_API_URL
ADMIN_TOKEN=                               # set in production: protects admin routes (Bearer token)
AUTO_PUBLISH=false                         # publish automatically when a pipeline finishes

# --- AI vision: image classification, floor plan reading, photo→room matching, materials ---
VISION_PROVIDER=auto                       # auto | anthropic | openai | heuristic
ANTHROPIC_API_KEY=                         # recommended (Claude vision)
CLAUDE_VISION_MODEL=claude-opus-5-5
OPENAI_API_KEY=                            # optional fallback provider
OPENAI_VISION_MODEL=gpt-4.1

# --- maps & surroundings (web) ---
GOOGLE_MAPS_API_KEY=                       # Photorealistic 3D Tiles (Map Tiles API enabled)
MAPBOX_TOKEN=                              # satellite ground texture + geocoding of addresses
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=           # local dev only (compose passes GOOGLE_MAPS_API_KEY)
NEXT_PUBLIC_MAPBOX_TOKEN=                  # local dev only (compose passes MAPBOX_TOKEN)

# --- photorealism providers (ReconstructionProvider, all optional) ---
# Local Gaussian Splatting needs the GPU worker: docker compose --profile gpu up
SPLAT_LOCAL=auto                           # auto | off
SPLAT_ITERS=15000
SPLAT_PROVIDER=                            # force a provider name, e.g. http_splat
# Generic HTTP job contract (see workers/py/propertyverse_workers/providers/builtin.py)
SPLAT_API_URL=
SPLAT_API_KEY=
WORLDGEN_API_URL=                          # image-to-3D / world generation (marked AI-generated)
WORLDGEN_API_KEY=
PANORAMA_API_URL=                          # generated 360° panoramas (marked AI-generated)
PANORAMA_API_KEY=
PANORAMA_PROVIDER=                         # panorama_stitch (default) | http_panorama

# --- scraping ---
SCRAPER_USER_AGENT=PropertyVerseBot/0.1 (+https://your-domain.example/bot)
SEED_CONFIRM_FUTUREHOMES=true              # seed marks futurehomesinternational.com as rights-confirmed
CHROMIUM_PATH=                             # only if Playwright's bundled Chromium is not used

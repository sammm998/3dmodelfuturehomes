{
  "name": "propertyverse",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pv/api --filter @pv/web --filter @pv/worker dev",
    "build": "pnpm --filter @pv/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:py",
    "test:py": "cd workers/py && python -m pytest -q",
    "fixtures": "pnpm --filter @pv/shared exec tsx scripts/export-fixtures.ts",
    "db:migrate": "pnpm --filter @pv/api migrate",
    "db:seed": "pnpm --filter @pv/api seed"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
